---
import Icon from '../Icon.astro';
import type { CONTACTS } from '../../data/content';

interface Props {
  items: typeof CONTACTS.items;
}
const { items } = Astro.props;
---

<ul class="icon-list">
  {
    items.map((item) => (
      <li>
        <Icon name={item.icon} />
        <span class="icon-label" set:html={item.html} />
      </li>
    ))
  }
</ul>

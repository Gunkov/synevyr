---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchNews, type NewsItem } from '../../data/news';

export async function getStaticPaths() {
  const news = await fetchNews();
  return news.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

interface Props {
  item: NewsItem;
}

const { item } = Astro.props;
---

<BaseLayout title={`${item.title} | ОСББ «Синевирій»`} description={item.excerpt}>
  <section class="sec-news-article">
    <div class="inner">
      <div class="article-card card-white">
        <div class="article-top-nav">
          <a href="/#novyny" class="back-link">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" width="14" height="14" aria-hidden="true" focusable="false" style="display:inline-block;vertical-align:middle;margin-right:6px;">
              <path fill="currentColor" d="M257.5 445.1l-22.2 22.2c-9.4 9.4-24.6 9.4-33.9 0L7 273c-9.4-9.4-9.4-24.6 0-33.9L201.4 44.7c9.4-9.4 24.6-9.4 33.9 0l22.2 22.2c9.5 9.5 9.3 25-.4 34.3L136.6 216H424c13.3 0 24 10.7 24 24v32c0 13.3-10.7 24-24 24H136.6l120.5 114.8c9.8 9.3 10 24.8.4 34.3z"/>
            </svg>
            Назад до всіх новин
          </a>
        </div>

        <header class="article-header">
          <time class="article-date">{item.date}</time>
          <h1 class="article-title">{item.title}</h1>
          <div class="article-sep"></div>
        </header>

        <div class="article-body" set:html={item.contentHtml || item.excerpt} />

        <div class="article-bottom-nav">
          <a href="/#novyny" class="btn-pill">← Назад до новин</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .sec-news-article {
    padding: 50px 20px 80px;
    background-color: var(--c-page-bg, #ebebeb);
    min-height: calc(100vh - 200px);
  }

  .article-card {
    max-width: var(--w-inner, 1185px);
    margin: 0 auto;
    padding: 40px 50px 60px;
    background-color: #fff;
    border-radius: 10px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  .article-top-nav {
    margin-bottom: 25px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    color: var(--c-brand, #2b6cb0);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--c-accent, #e76f51);
    text-decoration: underline;
  }

  .article-date {
    display: inline-block;
    color: #888;
    font-size: 14px;
    margin-bottom: 12px;
  }

  .article-title {
    font-size: 32px;
    line-height: 1.3;
    font-weight: 700;
    color: var(--c-teal, #1e4e8c);
    margin: 0 0 20px;
  }

  .article-sep {
    border-top: 4px solid var(--c-green, #38a169);
    width: 100%;
    margin: 0 0 35px;
  }

  .article-body {
    color: rgba(1, 22, 39, 0.85);
    font-size: 16px;
    line-height: 1.75;
  }

  .article-body :global(p) {
    margin: 0 0 1.25em;
  }

  .article-body :global(h2),
  .article-body :global(h3),
  .article-body :global(h4) {
    color: var(--c-teal, #1e4e8c);
    margin: 1.5em 0 0.75em;
    line-height: 1.35;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 1.25em 1.5em;
    padding: 0;
  }

  .article-body :global(li) {
    margin-bottom: 0.5em;
  }

  .article-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
    margin: 1.5em 0;
    display: block;
  }

  .article-body :global(blockquote) {
    border-left: 4px solid var(--c-brand, #2b6cb0);
    padding: 0.5em 0 0.5em 1.25em;
    margin: 1.5em 0;
    font-style: italic;
    color: #555;
    background: rgba(43, 108, 176, 0.05);
    border-radius: 0 6px 6px 0;
  }

  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5em 0;
  }

  .article-body :global(th),
  .article-body :global(td) {
    border: 1px solid #ddd;
    padding: 10px 14px;
    text-align: left;
  }

  .article-body :global(th) {
    background-color: #f5f7f9;
  }

  .article-bottom-nav {
    margin-top: 50px;
    padding-top: 30px;
    border-top: 1px solid #eee;
  }

  @media (max-width: 767px) {
    .sec-news-article {
      padding: 25px 12px 50px;
    }

    .article-card {
      padding: 25px 20px 40px;
    }

    .article-title {
      font-size: 24px;
    }

    .article-body {
      font-size: 15px;
      line-height: 1.65;
    }
  }
</style>
